# Copy this file to .env.local and fill in your key:
#
#   cp .env.local.example .env.local
#
# Required. YouTube Data API v3 key from the Google Cloud Console.
# Server-side only — there is deliberately no NEXT_PUBLIC_ prefix, so this value
# is never bundled into client JavaScript. All YouTube calls go through
# /api/search.
YOUTUBE_API_KEY=

# --- Optional: Google sign-in for YouTube account linking ---
# Leave these blank and the app works exactly as before, minus the sign-in
# button. Set them to seed your feed from your real YouTube subscriptions, which
# costs ~3 units instead of the ~208 the topic searches cost.
#
# Create at: Google Cloud Console -> APIs & Services -> Credentials ->
# Create Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Your site's base URL. http://localhost:3000 for local development;
# on Vercel this is set automatically, so you can leave it blank there.
NEXTAUTH_URL=http://localhost:3000
